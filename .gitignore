# ============================================================
# Repository structure
# ============================================================
# This .gitignore belongs at the repository root.
#
# Unity project:
#   /AnimationA3/
#
# Maya files and other source files may exist beside it.

# ============================================================
# Unity-generated folders
# ============================================================

/AnimationA3/.utmp/
/AnimationA3/[Ll]ibrary/
/AnimationA3/[Tt]emp/
/AnimationA3/[Oo]bj/
/AnimationA3/[Bb]uild/
/AnimationA3/[Bb]uilds/
/AnimationA3/[Ll]ogs/
/AnimationA3/[Uu]ser[Ss]ettings/
/AnimationA3/[Mm]emoryCaptures/
/AnimationA3/[Rr]ecordings/

# Unity and tool logs
*.log

# Unity supports Blender files directly, but Blender backup files
# do not need to be committed.
*.blend1
*.blend1.meta

# Uncomment if Asset Store Tools is installed and should be ignored.
# /AnimationA3/[Aa]ssets/AssetStoreTools*

# ============================================================
# Unity editor and IDE-generated files
# ============================================================

# JetBrains Rider Unity plugin
/AnimationA3/[Aa]ssets/Plugins/Editor/JetBrains*

# Rider personal settings
*.DotSettings.user

# Visual Studio cache
.vs/

# Visual Studio Code settings
.vscode/

# JetBrains IDE settings
.idea/

# Gradle cache
.gradle/

# Unity-generated solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated metadata for compiled files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash files
sysinfo.txt
mono_crash.*

# ============================================================
# Unity builds and exported packages
# ============================================================

*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics-generated file
crashlytics-build.properties

# ============================================================
# Unity Test Runner
# ============================================================

InitTestScene*.unity*
/AnimationA3/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ============================================================
# Unity Addressables-generated content
# ============================================================

/AnimationA3/ServerData/
/AnimationA3/[Aa]ssets/StreamingAssets/aa*
/AnimationA3/[Aa]ssets/AddressableAssetsData/link.xml*
/AnimationA3/[Aa]ssets/Addressables_Temp*
/AnimationA3/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ============================================================
# Unity Visual Scripting-generated content
# ============================================================

/AnimationA3/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/AnimationA3/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/AnimationA3/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/AnimationA3/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Unity scene dependency cache
/AnimationA3/[Aa]ssets/[Ss]ceneDependencyCache*

# ============================================================
# Maya-generated and temporary files
# ============================================================

# Keep actual Maya scenes:
#   *.ma
#   *.mb
#
# Ignore backups and temporary files:
*.ma~
*.mb~
*.bak
*.swp

# Maya-generated temporary folders
**/autosave/
**/incrementalSave/
**/mayaSwatches/
**/renderData/

# Maya crash and log files
mayaLog
Maya.env

# ============================================================
# macOS and Windows-generated files
# ============================================================

.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.iniAnimationMichelle_A3.mov
dulceherbst_animationA3.zip
AnimationMichelle_A3.mov
